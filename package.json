{
  "name": "poosd-colors",
  "version": "1.0.0",
  "private": true,
  "description": "Development-only lint tools for the COLORS LAMP application",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "lint:html": "htmlhint --config .htmlhintrc --ignore \"node_modules/**\" \"**/*.html\"",
    "lint:css": "stylelint \"**/*.css\" --max-warnings 0",
    "lint:js": "eslint . --max-warnings 0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "htmlhint": "1.9.2",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0"
  }
}
